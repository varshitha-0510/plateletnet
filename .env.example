# PlateletNet environment template (copy to .env).
# Use synthetic/demo data only. Do not store real patient information.

PLATELETNET_APP_NAME=PlateletNet
PLATELETNET_ENV=development

DATABASE_URL=sqlite:///./plateletnet.db
API_HOST=127.0.0.1
API_PORT=8000

USE_SYNTHETIC_DATA_ONLY=true

# Simulated Micro-Expiry — Research/Demo Only
# Hypothetical approved-extension scenario in simulation. Not a medical expiry change.
SIMULATED_MICRO_EXPIRY_ENABLED=false
